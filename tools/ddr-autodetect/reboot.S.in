/*
 * Reboot-to-maskrom payload template — DDR auto-detect.
 *
 * Assemble with: -DBOOT_MODE_REG=<PMU_GRF OS_REG0 addr> -DMASKROM_MAGIC=<magic>
 *                -DCRU_RESET_REG=<CRU global-soft-reset addr> -DCRU_RESET_VAL=<value>
 *
 * Runs as a DDR Test Tool "test item" (bulk-downloaded to the cfg download base,
 * entered via RunMemory), in place, right after the osregdump probe has read
 * OS_REG. Writes the maskrom boot-mode magic to BOOT_MODE_REG so the next power
 * cycle/reset drops into MASKROM download mode, then triggers a CRU global
 * soft-reset. Does NOT return — the device resets; there is no host-visible
 * result code for this item.
 */
    .text
    .globl _start
    .align 2
_start:
    movz    x0, #(BOOT_MODE_REG & 0xFFFF)
    movk    x0, #((BOOT_MODE_REG >> 16) & 0xFFFF), lsl #16
    movz    w1, #(MASKROM_MAGIC & 0xFFFF)
    movk    w1, #((MASKROM_MAGIC >> 16) & 0xFFFF), lsl #16
    str     w1, [x0]                    // boot-mode = MASKROM download
    dsb     sy
    movz    x2, #(CRU_RESET_REG & 0xFFFF)
    movk    x2, #((CRU_RESET_REG >> 16) & 0xFFFF), lsl #16
    movz    w3, #(CRU_RESET_VAL & 0xFFFF)
    movk    w3, #((CRU_RESET_VAL >> 16) & 0xFFFF), lsl #16
    str     w3, [x2]                    // CRU global soft-reset
    dsb     sy
.Lspin:
    wfi
    b       .Lspin
